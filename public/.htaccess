# Apache (hosting Gigaserver). Na Cloudflare Pages se nepoužije – tam je _redirects.
RewriteEngine On

# Vše na https://www.fyziovojta.cz (z http:// i z holé domény)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.fyziovojta.cz%{REQUEST_URI} [R=301,L]

# /index.html → /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# Cache: Astro soubory mají v názvu hash → můžou se cachovat napořád
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
